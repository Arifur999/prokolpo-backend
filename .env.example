# Copy to .env for local runs. Never commit real values.

# development | test | production
APP_ENV=development
HTTP_ADDR=:5000

# Matches the db service in docker-compose.yml.
DATABASE_URL=postgres://prokolpo:prokolpo@localhost:5433/prokolpo?sslmode=disable
DB_MAX_CONNS=10

# debug | info | warn | error
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s

# At least 32 random bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-bytes-please
ACCESS_TOKEN_TTL=15m

# The frontend origin; password reset emails link here.
APP_URL=http://localhost:3000

# Leave SMTP_HOST empty locally: emails are printed to the log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Prokolpo <no-reply@prokolpo.app>
