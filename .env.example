# Copy to .env for local runs. Never commit real values.

# development | test | production
APP_ENV=development
HTTP_ADDR=:5000

# Matches the db service in docker-compose.yml.
DATABASE_URL=postgres://prokolpo:prokolpo@localhost:5433/prokolpo?sslmode=disable
DB_MAX_CONNS=10

# debug | info | warn | error
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s
